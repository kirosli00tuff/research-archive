# HFExperiment daily bar collection and shadow accrual.
# Mon to Fri at 23:30 UTC, after the US close, staggered one hour from
# AiTrader's 22:30 so two collectors never share a rate window.
# Installed to ~/.config/systemd/user/ by scripts/install_timer.sh.

[Unit]
Description=HFExperiment daily bars, shadow accrual, verdict

[Timer]
OnCalendar=Mon..Fri *-*-* 23:30:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
